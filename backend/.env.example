PORT=5000
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
ADMIN_PASSWORD=your_admin_password
JWT_SECRET=your_jwt_secret

# Email Configuration (Resend - free: 100 emails/day)
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_EMAIL=your_email@example.com

# Google reCAPTCHA v2 secret — must match the frontend site key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Plausible Analytics (https://plausible.io) — used by /admin/analytics
PLAUSIBLE_SITE_ID=imfarid.com
PLAUSIBLE_API_KEY=your_plausible_api_key
# Optional shared dashboard link (Site settings → Visibility)
PLAUSIBLE_SHARED_LINK=
